{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["next-env.d.ts", ".next/**", "lib/api/schema.d.ts"],
  "plugins": ["typescript", "react", "nextjs", "import"],
  "rules": {
    "no-debugger": "error",
    "no-unused-vars": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "zod",
            "message": "Import z from @/lib/forms/zod: it disables zod's eval probe, which our CSP reports as a violation (Feature 03 slice 3.10)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["instrumentation-client.ts"],
      "rules": {
        "import/namespace": "off"
      }
    },
    {
      "files": ["e2e/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@playwright/test",
                "importNames": ["test", "expect"],
                "message": "Import test/expect from ./fixtures: it fails tests on CSP violations (Feature 03 slice 3.2)."
              },
              {
                "name": "zod",
                "message": "Import z from @/lib/forms/zod."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["e2e/fixtures.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["lib/forms/zod.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
