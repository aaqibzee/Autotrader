# Copy to .env for local development. Every credential below is a local-only placeholder:
# the API refuses to boot with any of them when ENVIRONMENT is staging or production.
# Never deploy with these values; see ops/runbooks/secrets.md.

# --- Runtime -----------------------------------------------------------------
# local | staging | production
ENVIRONMENT=local
SECRET_KEY=local-only-change-this-secret-key
# Comma-separated Host headers the API accepts (TrustedHostMiddleware).
ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver
# Peers allowed to supply X-Verified-Cloudflare-Peer (the local reverse proxy only).
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
# AnyIO threadpool for sync endpoints; keep >= API DB pool size + overflow.
THREADPOOL_SIZE=40

# --- PostgreSQL (127.0.0.1, not localhost: avoids the IPv6 resolution hang) ---
POSTGRES_DB=autotrader
POSTGRES_USER=autotrader
POSTGRES_PASSWORD=local-only-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://autotrader:local-only-postgres-password@127.0.0.1:5432/autotrader
# Per-connection cap on any app query; 0 disables (never in production).
DB_STATEMENT_TIMEOUT_MS=5000

# --- Redis: broker (noeviction) and cache (allkeys-lru) are separate on purpose ---
REDIS_BROKER_PORT=6379
REDIS_CACHE_PORT=6380
REDIS_BROKER_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6380/1

# --- S3-compatible object storage (SeaweedFS locally, R2/S3 when deployed) ---
S3_PORT=9000
S3_ENDPOINT=127.0.0.1:9000
S3_REGION=us-east-1
S3_SECURE=false
S3_BUCKET=autotrader-uploads
# Bucket-scoped app key: read/write/list on S3_BUCKET only.
S3_ACCESS_KEY=autotrader-local
S3_SECRET_KEY=local-autotrader-secret-change-me
# Admin identity for the local store only; used by the bucket init container, never the app.
S3_ROOT_ACCESS_KEY=local-s3-root
S3_ROOT_SECRET_KEY=local-s3-root-change-me

# --- URLs --------------------------------------------------------------------
FRONTEND_URL=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:8000
# Where Next.js SSR reaches the API directly (never via Cloudflare).
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# --- Web Content-Security-Policy extra origins (https only; blank = not allowed) ---
IMAGE_CDN_ORIGIN=
ERROR_INGEST_ORIGIN=
UPLOADS_BUCKET_ORIGIN=

# --- Observability (blank = disabled) ----------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Integrations ------------------------------------------------------------
RESEND_API_KEY=

# --- Feature flags (on | off; unset = read from the feature_flags table) -------
FLAG_VALUE_MY_CAR=off
