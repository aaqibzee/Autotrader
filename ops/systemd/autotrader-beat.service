[Unit]
Description=Autotrader Celery beat (exactly one; guarded by a Redis lock)
After=network-online.target
Wants=network-online.target
PartOf=autotrader.target

[Service]
EnvironmentFile=/etc/autotrader/autotrader.env
# Unbuffered so logs reach journald immediately and survive a crash.
Environment=PYTHONUNBUFFERED=1
User=autotrader
Group=autotrader
WorkingDirectory=/opt/autotrader/current/backend
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/autotrader/shared
ExecStart=/opt/autotrader/current/backend/.venv/bin/celery -A app.core.celery_app:celery_app beat --loglevel=INFO --schedule /opt/autotrader/shared/celerybeat-schedule
# Feature 01 §16 budget: this app shares the VM with Yaqlo, Duely, Scout and Suretly.
MemoryMax=128M
CPUQuota=25%
TimeoutStopSec=30

[Install]
WantedBy=autotrader.target
