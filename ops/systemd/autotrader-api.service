[Unit]
Description=Autotrader API (FastAPI)
After=network-online.target
Wants=network-online.target
PartOf=autotrader.target

[Service]
EnvironmentFile=/etc/autotrader/autotrader.env
# Unbuffered so logs reach journald immediately and survive a crash.
Environment=PYTHONUNBUFFERED=1
User=autotrader
Group=autotrader
WorkingDirectory=/opt/autotrader/current/backend
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/autotrader/shared
ExecStart=/opt/autotrader/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-graceful-shutdown 20
# Feature 01 §16 budget: this app shares the VM with Yaqlo, Duely, Scout and Suretly.
MemoryMax=512M
CPUQuota=100%
TimeoutStopSec=30

[Install]
WantedBy=autotrader.target
