# Normalise to LF in the repo; scripts and configs run on Linux (containers, the VM)
# where a CRLF shebang or nginx directive breaks outright.
* text=auto eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.sql text eol=lf
*.pdf binary
*.png binary
*.woff2 binary
